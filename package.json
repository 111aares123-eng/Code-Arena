{
  "name": "code-arena",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run ./scripts/dev.ts",
    "dev:web": "bun --filter web dev",
    "dev:api": "bun --filter api dev",
    "build": "bun --filter web build",
    "typecheck": "bun --filter @code-arena/db typecheck && bun --filter api typecheck && bun --filter web typecheck",
    "lint": "bun --filter web lint",
    "db:generate": "bun --filter @code-arena/db generate",
    "db:migrate": "bun --filter @code-arena/db migrate",
    "db:push": "bun --filter @code-arena/db push",
    "db:studio": "bun --filter @code-arena/db studio",
    "db:seed": "bun --filter @code-arena/db seed",
    "test": "bun run test:root && bun run test:api",
    "test:root": "node --test tests/*.test.mjs",
    "test:api": "bun --filter api test"
  }
}
