# CodeArena — backend configuration (Node.js 24+)
# Copy to .env at the repository root. pnpm dev:api loads it automatically.
# For database commands also copy packages/db/.env.example to packages/db/.env.
# For the browser copy apps/web/.env.example to apps/web/.env.local.
# Never commit .env files or put credentials in NEXT_PUBLIC_* variables.

# Local PostgreSQL only; replace these development credentials for deployment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codearena
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_CONNECT_TIMEOUT=10

PORT=3001
# Exact browser origin, including port. Used for tRPC AND activity-stream CORS.
WEB_ORIGIN=http://localhost:3000

# Server-only Judge0 endpoint. Run code only in an isolated Judge0 deployment.
JUDGE0_BASE_URL=http://localhost:2358
# Optional credentials for authenticated providers:
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Match these IDs to the languages installed on your Judge0 server.
JUDGE0_PYTHON_LANG_ID=71
JUDGE0_CPP_LANG_ID=54
# End-to-end deadline per test case, including queued-job polling.
JUDGE0_SUBMISSION_TIMEOUT_MS=10000

# Secret token for test case administration (minimum 32 characters).
# Test-case management endpoints fail-closed (FORBIDDEN) if this token is unset or too short.
ADMIN_API_TOKEN=change-me-to-a-secure-random-token-at-least-32-chars-long

