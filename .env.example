# CodeArena 2.0 Environment Configuration Template
# Copy this file to .env and provide your local credentials.

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codearena

# API Server Port
PORT=3001

# Allowed web app origin for the live activity event stream
WEB_ORIGIN=http://localhost:3000

# Judge0 CE Server Configuration (Server-Side Only)
# Default for local Judge0 CE Docker container is http://localhost:2358
JUDGE0_BASE_URL=http://localhost:2358

# Optional: API Key for authenticated Judge0 instances or RapidAPI
# JUDGE0_API_KEY=your_api_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Judge0 Language IDs (defaults to standard CE IDs)
# Python 3.8.1: 71, Python 3.11.2: 92
JUDGE0_PYTHON_LANG_ID=71
# C++ (GCC 9.2.0): 54, C++ (GCC 14.1.0): 105
JUDGE0_CPP_LANG_ID=54

# Timeout in milliseconds for code execution requests (default 10000ms = 10s)
JUDGE0_SUBMISSION_TIMEOUT_MS=10000
